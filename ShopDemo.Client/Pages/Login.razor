@page "/login"
@inherits ShopPageBase

<PageTitle>Log in - ShopDemo</PageTitle>
<MudText Typo="Typo.h4" GutterBottom="true">Log in</MudText>
@if (Auth.CurrentUser is not null)
{
    <MudAlert data-testid="login-already" Severity="Severity.Success">You are logged in as @Auth.CurrentUser.Email.</MudAlert>
}
else
{
    <MudPaper Class="pa-5 login-panel">
        <div data-testid="login-form">
        <EditForm Model="@_model" OnValidSubmit="@LoginAsync">
            <DataAnnotationsValidator />
            <MudStack Spacing="3">
                <MudTextField T="string" data-testid="login-email" Label="Email" @bind-Value="_model.Email" For="@(() => _model.Email)" Variant="Variant.Outlined" />
                <MudTextField T="string"
                              data-testid="login-password"
                              Label="Password"
                              InputType="InputType.Password"
                              @bind-Value="_model.Password"
                              For="@(() => _model.Password)"
                              Variant="Variant.Outlined" />
                <ValidationSummary />
                @if (_error is not null)
                {
                    <MudAlert data-testid="login-error" Severity="Severity.Error">@_error</MudAlert>
                }
                <MudButton data-testid="login-submit" ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@_submitting">
                    @(_submitting ? "Signing in..." : "Log in")
                </MudButton>
            </MudStack>
        </EditForm>
        </div>
        <MudText Typo="Typo.body2" Class="mt-4">New here? <MudLink data-testid="login-register-link" Href="@RegisterHref">Create an account</MudLink></MudText>
        <MudText Typo="Typo.caption" Class="mt-2" data-testid="login-demo-hint">
            Demo accounts: demo@test.com (shopper), admin@test.com (store manager), jane@test.com (second shopper) – password 1234.
        </MudText>
    </MudPaper>
}
