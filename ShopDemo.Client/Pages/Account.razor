@page "/account"
@inherits ShopPageBase

<PageTitle>My account - ShopDemo</PageTitle>
<div data-testid="account-page">
<MudText Typo="Typo.h4" GutterBottom="true">My account</MudText>
@if (Auth.CurrentUser is null)
{
    <MudAlert Severity="Severity.Info">Redirecting to login...</MudAlert>
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-5" data-testid="account-profile-form">
                <MudText Typo="Typo.h6" GutterBottom="true">Profile and default shipping address</MudText>
                <EditForm Model="@_profile" OnValidSubmit="@SaveProfileAsync">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="3">
                        <MudTextField T="string" data-testid="account-email" Label="Email" Value="@Auth.CurrentUser.Email" ReadOnly="true" Variant="Variant.Outlined" />
                        <MudText data-testid="account-role" Typo="Typo.caption">Role: @(Auth.IsManager ? "Store manager" : "Shopper")</MudText>
                        <MudTextField T="string" data-testid="account-name" Label="Name" @bind-Value="_profile.DisplayName" For="@(() => _profile.DisplayName)" Variant="Variant.Outlined" />
                        <MudTextField T="string" data-testid="account-phone" Label="Phone" @bind-Value="_profile.Phone" Variant="Variant.Outlined" />
                        <MudTextField T="string" data-testid="account-address" Label="Street and number" @bind-Value="_profile.AddressLine" Variant="Variant.Outlined" />
                        <MudGrid>
                            <MudItem xs="4"><MudTextField T="string" data-testid="account-postal-code" Label="Postal code" @bind-Value="_profile.PostalCode" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="8"><MudTextField T="string" data-testid="account-city" Label="City" @bind-Value="_profile.City" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>
                        <MudTextField T="string" data-testid="account-country" Label="Country" @bind-Value="_profile.Country" Variant="Variant.Outlined" />
                        <ValidationSummary />
                        @if (_profileError is not null)
                        {
                            <MudAlert data-testid="account-profile-error" Severity="Severity.Error">@_profileError</MudAlert>
                        }
                        @if (_profileSaved)
                        {
                            <MudAlert data-testid="account-profile-saved" Severity="Severity.Success">Your profile was saved.</MudAlert>
                        }
                        <MudButton data-testid="account-save-profile" ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">Save profile</MudButton>
                    </MudStack>
                </EditForm>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-5" data-testid="account-password-form">
                <MudText Typo="Typo.h6" GutterBottom="true">Change password</MudText>
                <EditForm Model="@_password" OnValidSubmit="@ChangePasswordAsync">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="3">
                        <MudTextField T="string" data-testid="account-current-password" Label="Current password" InputType="InputType.Password" @bind-Value="_password.CurrentPassword" For="@(() => _password.CurrentPassword)" Variant="Variant.Outlined" />
                        <MudTextField T="string" data-testid="account-new-password" Label="New password (min. 8 characters)" InputType="InputType.Password" @bind-Value="_password.NewPassword" For="@(() => _password.NewPassword)" Variant="Variant.Outlined" />
                        <MudTextField T="string" data-testid="account-confirm-password" Label="Repeat new password" InputType="InputType.Password" @bind-Value="_password.ConfirmPassword" For="@(() => _password.ConfirmPassword)" Variant="Variant.Outlined" />
                        <ValidationSummary />
                        @if (_passwordError is not null)
                        {
                            <MudAlert data-testid="account-password-error" Severity="Severity.Error">@_passwordError</MudAlert>
                        }
                        @if (_passwordChanged)
                        {
                            <MudAlert data-testid="account-password-changed" Severity="Severity.Success">Your password was changed.</MudAlert>
                        }
                        <MudButton data-testid="account-change-password" ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Outlined">Change password</MudButton>
                    </MudStack>
                </EditForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
}
</div>
