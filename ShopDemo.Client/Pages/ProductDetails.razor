@page "/products/{ProductId}"
@inject IProductCatalog Catalog
@inject ICartService Cart
@inject ISnackbar Snackbar
@inject IDemoAuthService Auth

<PageTitle>Product details - ShopDemo</PageTitle>
<div data-testid="product-details">
<MudButton Href="/" StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Text" Class="mb-3">Back to catalog</MudButton>
@if (_loading)
{
    <div class="loading-state"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><MudText>Loading product...</MudText></div>
}
else if (_product is null)
{
    <MudAlert Severity="Severity.Warning">This product could not be found.</MudAlert>
}
else
{
    <MudTabs Rounded="true"
             Elevation="0"
             ActivePanelIndex="@_activePanelIndex"
             ActivePanelIndexChanged="@OnActivePanelIndexChanged">
        <MudTabPanel Text="Overview">
            <TabContent><span data-testid="product-overview-tab">Overview</span></TabContent>
            <ChildContent>
                <div data-testid="product-overview-panel" class="pt-4">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="6">
                            <MudCard><MudCardMedia Image="@_product.ImageUrl" Height="360" /></MudCard>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudChip T="string" data-testid="product-overview-category" Color="Color.Secondary" Variant="Variant.Outlined">@_product.Category</MudChip>
                            <MudText data-testid="product-overview-name" Typo="Typo.h4" Class="mt-3">@_product.Name</MudText>
                            <MudText data-testid="product-overview-description" Typo="Typo.body1" Class="mt-3">@_product.Description</MudText>
                            <MudText data-testid="product-overview-price" Typo="Typo.h5" Color="Color.Primary" Class="mt-4">@_product.Price.ToString("C")</MudText>
                            @if (_product.IsAvailable)
                            {
                                <MudText Color="Color.Success" Class="my-2">@_product.Stock available</MudText>
                                @if (Auth.CurrentUser?.Role != DemoRole.StoreManager)
                                {
                                    <MudButton data-testid="product-details-add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@AddToCartAsync">Add to cart</MudButton>
                                }
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Error" Class="my-3">This product is currently out of stock.</MudAlert>
                            }
                        </MudItem>
                    </MudGrid>
                </div>
            </ChildContent>
        </MudTabPanel>
        <MudTabPanel Text="Inventory">
            <TabContent><span data-testid="product-inventory-tab">Inventory</span></TabContent>
            <ChildContent>
                <div data-testid="product-inventory-panel" class="pt-4">
                    @if (_inventoryLoading)
                    {
                        <div class="loading-state" role="status" aria-live="polite" data-testid="product-inventory-loading">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            <MudText>Loading inventory details...</MudText>
                        </div>
                    }
                    else if (_inventoryLoadError is not null)
                    {
                        <MudAlert Severity="Severity.Error">@_inventoryLoadError</MudAlert>
                    }
                    else
                    {
                        <div data-testid="product-inventory-grid">
                            <MudDataGrid T="InventoryGridRow"
                                         Items="@_inventoryRows"
                                         Filterable="true"
                                         FilterMode="DataGridFilterMode.ColumnFilterMenu"
                                         RowsPerPage="10"
                                         Dense="true"
                                         Hover="true"
                                         Striped="true">
                                <Columns>
                                    <PropertyColumn Property="row => row.Sequence" Title="#">
                                        <CellTemplate Context="cell">
                                            <MudText data-testid="@($"product-inventory-row-{cell.Item.Sequence}")">
                                                @cell.Item.Sequence
                                            </MudText>
                                        </CellTemplate>
                                    </PropertyColumn>
                                    <PropertyColumn Property="row => row.ProductId" Title="Product ID">
                                        <CellTemplate Context="cell">
                                            <MudText data-testid="@(GetInventoryCellTestId("product-inventory-id", cell.Item.Sequence))">
                                                @cell.Item.ProductId
                                            </MudText>
                                        </CellTemplate>
                                    </PropertyColumn>
                                    <PropertyColumn Property="row => row.Stock" Title="Stock">
                                        <CellTemplate Context="cell">
                                            <MudText data-testid="@(GetInventoryCellTestId("product-inventory-stock", cell.Item.Sequence))">
                                                @cell.Item.Stock
                                            </MudText>
                                        </CellTemplate>
                                    </PropertyColumn>
                                    <PropertyColumn Property="row => row.Availability" Title="Availability">
                                        <CellTemplate Context="cell">
                                            <MudText data-testid="@(GetInventoryCellTestId("product-inventory-availability", cell.Item.Sequence))">
                                                @cell.Item.Availability
                                            </MudText>
                                        </CellTemplate>
                                    </PropertyColumn>
                                </Columns>
                                <PagerContent>
                                    <div data-testid="product-inventory-pager">
                                        <MudDataGridPager T="InventoryGridRow" />
                                    </div>
                                </PagerContent>
                            </MudDataGrid>
                        </div>
                    }
                </div>
            </ChildContent>
        </MudTabPanel>
    </MudTabs>
}
</div>
