@page "/register"
@inherits ShopPageBase

<PageTitle>Create account - ShopDemo</PageTitle>
<MudText Typo="Typo.h4" GutterBottom="true">Create an account</MudText>
@if (Auth.CurrentUser is not null)
{
    <MudAlert data-testid="register-already" Severity="Severity.Success">You are logged in as @Auth.CurrentUser.Email.</MudAlert>
}
else
{
    <MudPaper Class="pa-5 login-panel">
        <div data-testid="register-form">
        <EditForm Model="@_model" OnValidSubmit="@RegisterAsync">
            <DataAnnotationsValidator />
            <MudStack Spacing="3">
                <MudTextField T="string" data-testid="register-name" Label="Full name" @bind-Value="_model.DisplayName" For="@(() => _model.DisplayName)" Variant="Variant.Outlined" />
                <MudTextField T="string" data-testid="register-email" Label="Email" @bind-Value="_model.Email" For="@(() => _model.Email)" Variant="Variant.Outlined" />
                <MudTextField T="string" data-testid="register-password" Label="Password (min. 8 characters)" InputType="InputType.Password" @bind-Value="_model.Password" For="@(() => _model.Password)" Variant="Variant.Outlined" />
                <MudTextField T="string" data-testid="register-confirm-password" Label="Repeat password" InputType="InputType.Password" @bind-Value="_model.ConfirmPassword" For="@(() => _model.ConfirmPassword)" Variant="Variant.Outlined" />
                <ValidationSummary />
                @if (_error is not null)
                {
                    <MudAlert data-testid="register-error" Severity="Severity.Error">@_error</MudAlert>
                }
                <MudButton data-testid="register-submit" ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@_submitting">
                    @(_submitting ? "Creating account..." : "Create account")
                </MudButton>
            </MudStack>
        </EditForm>
        </div>
        <MudText Typo="Typo.body2" Class="mt-4">Already registered? <MudLink data-testid="register-login-link" Href="/login">Log in</MudLink></MudText>
    </MudPaper>
}
